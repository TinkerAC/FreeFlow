{
  // VS Code Tasks for FreeFlow
  // 运行部署脚本 tools/deploy.ts（跨平台）
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy Local Build",
      "type": "shell",
      "command": "pnpm run deploy:local",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build And Deploy Local",
      "type": "shell",
      "command": "pnpm run build:dir:deploy",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}

