{
  "name": "free-flow",
  "version": "1.1.0",
  "description": "",
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "dev": "cross-env NODE_ENV=development npm run build:css && cross-env NODE_ENV=development npm run build && cross-env NODE_ENV=development concurrently \"electron .\"",
    "start": "cross-env NODE_ENV=production npm run build:css && cross-env NODE_ENV=production npm run build && cross-env NODE_ENV=production concurrently \"electron .\"",
    "proxy": "node src/proxy.js",
    "build:css": "tailwindcss -i src/tailwind.css -o public/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/tailwind.css -o public/tailwind.css --watch",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "app.freeflow",
    "productName": "FreeFlow",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "config/**/*",
      "package.json",
      "public/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    }
  },
  "browser": {
    "fs": false
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^7.1.2",
    "electron": "^31.3.1",
    "electron-builder": "^25.0.5",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss-loader": "^8.1.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.10",
    "util": "^0.12.5",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.4",
    "cheerio": "^1.0.0",
    "colorthief": "^2.6.0",
    "config": "^3.3.12",
    "deep-equal": "^2.2.3",
    "electron-localshortcut": "^1.1.1",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^24.1.1",
    "music-metadata": "^10.0.1",
    "node-fetch": "^3.3.2",
    "pinyin": "^4.0.0-alpha.2",
    "pinyin-pro": "^3.25.0",
    "postcss": "^8.4.41",
    "prop-types": "^15.8.1",
    "random-useragent": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-usestateref": "^1.0.9",
    "request": "^2.88.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7",
    "tiny-pinyin": "^1.3.2"
  }
}
