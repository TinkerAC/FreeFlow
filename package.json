{
  "name": "freeflow-monorepo",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sqlite3"
    ]
  },
  "scripts": {
    "dev:web": "pnpm --filter web run dev",
    "dev:desktop": "pnpm --filter freeflow run dev",
    "dev:backend": "pnpm --filter freeflow-web25-backend run dev",
    "build:backend": "pnpm --filter freeflow-web25-backend run build",
    "db:backend:push": "pnpm --filter freeflow-web25-backend run prisma:push",
    "db:backend:comments": "pnpm --filter freeflow-web25-backend run prisma:comments",
    "db:backend:studio": "pnpm --filter freeflow-web25-backend run prisma:studio"
  },
  "packageManager": "pnpm@10.0.0+sha512.b8fef5494bd3fe4cbd4edabd0745df2ee5be3e4b0b8b08fa643aa3e4c6702ccc0f00d68fa8a8c9858a735a0032485a44990ed2810526c875e416f001b17df12b"
}
