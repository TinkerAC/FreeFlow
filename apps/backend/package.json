{
  "name": "freeflow-web25-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/index.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push  --force-reset --schema prisma/schema.prisma",
    "prisma:comments": "prisma db execute --schema prisma/schema.prisma --file prisma/schema.comments.sql",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "start": "node dist/index.js",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/busboy": "^2.1.1",
    "@prisma/client": "^6.7.0",
    "ethers": "^6.16.0",
    "express": "^4.22.1",
    "pg": "^8.16.0",
    "pino": "7.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.24",
    "prisma": "^6.7.0",
    "typescript": "^5.9.3"
  }
}
