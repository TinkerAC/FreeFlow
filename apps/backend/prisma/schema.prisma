generator client {
  provider = "prisma-client-js"
}

// Web2.5 backend PostgreSQL connection.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CreatorReleaseStatus {
  DRAFT
  ASSETS_PENDING
  ASSETS_UPLOADED
  METADATA_UPLOADED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ReleaseAccessModel {
  open
  purchase
}

enum StorageNetwork {
  public
  private
}

enum PurchaseStatus {
  pending
  confirmed
  failed
  refunded
}

model User {
  id                      String           @id @default(cuid())
  displayName             String?          @db.VarChar(64)
  avatarUrl               String?          @db.Text
  primaryWalletIdentityId String?          @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  walletIdentities        WalletIdentity[] @relation("UserWalletIdentities")
  primaryWalletIdentity   WalletIdentity?  @relation("UserPrimaryWallet", fields: [primaryWalletIdentityId], references: [id], onDelete: SetNull)
  authSessions            AuthSession[]
  storageUploads          StorageUpload[]
  creatorReleases         CreatorRelease[]
  purchases               Purchase[]       @relation("PurchaseBuyer")
  royaltyClaims           RoyaltyClaim[]    @relation("RoyaltyClaimClaimer")
  comments                Comment[]

  @@map("users")
}

model WalletIdentity {
  id                  String        @id @default(cuid())
  userId              String
  address             String        @db.VarChar(42)
  addressLower        String        @db.VarChar(42)
  chainId             Int
  verifiedAt          DateTime
  lastAuthenticatedAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User          @relation("UserWalletIdentities", fields: [userId], references: [id], onDelete: Cascade)
  primaryForUser      User?         @relation("UserPrimaryWallet")
  authSessions        AuthSession[]

  @@unique([addressLower, chainId])
  @@index([userId])
  @@map("wallet_identities")
}

model SiweNonce {
  id                    String    @id @default(cuid())
  nonceHash             String    @unique @db.Char(64)
  requestedAddress      String?   @db.VarChar(42)
  requestedAddressLower String?   @db.VarChar(42)
  requestedChainId      Int?
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([expiresAt])
  @@index([requestedAddressLower, requestedChainId])
  @@map("siwe_nonces")
}

model AuthSession {
  id               String         @id @default(cuid())
  userId           String
  walletIdentityId String
  tokenHash        String         @unique @db.Char(64)
  address          String         @db.VarChar(42)
  chainId          Int
  domain           String         @db.VarChar(255)
  uri              String         @db.Text
  issuedAt         DateTime
  verifiedAt       DateTime
  expiresAt        DateTime
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletIdentity   WalletIdentity @relation(fields: [walletIdentityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletIdentityId])
  @@index([expiresAt, revokedAt])
  @@map("auth_sessions")
}

model StorageObject {
  id               String           @id @default(cuid())
  cid              String           @unique @db.VarChar(255)
  size             Int
  mimeType         String           @db.VarChar(255)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  uploads          StorageUpload[]
  audioReleases    CreatorRelease[] @relation("CreatorReleaseAudioObject")
  coverReleases    CreatorRelease[] @relation("CreatorReleaseCoverObject")
  metadataReleases CreatorRelease[] @relation("CreatorReleaseMetadataObject")

  @@index([cid])
  @@map("storage_objects")
}

model StorageUpload {
  id              String         @id @default(cuid())
  storageObjectId String
  uploaderUserId  String
  pinataId        String?        @unique @db.VarChar(255)
  originalName    String         @db.VarChar(255)
  network         StorageNetwork @default(public)
  groupId         String?        @db.VarChar(255)
  createdAt       DateTime       @default(now())
  storageObject   StorageObject  @relation(fields: [storageObjectId], references: [id], onDelete: Cascade)
  uploader        User           @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)

  @@index([uploaderUserId, createdAt])
  @@index([storageObjectId, createdAt])
  @@map("storage_uploads")
}

model CreatorRelease {
  id                      String               @id @default(cuid())
  creatorUserId           String
  title                   String               @db.VarChar(255)
  artistName              String?              @db.VarChar(255)
  albumName               String?              @db.VarChar(255)
  genreLabel              String?              @db.VarChar(255)
  slug                    String               @db.VarChar(255)
  description             String?              @db.Text
  status                  CreatorReleaseStatus @default(DRAFT)
  currentStage            String               @default("editor") @db.VarChar(32)
  accessModel             ReleaseAccessModel   @default(purchase)
  previewSeconds          Int                  @default(30)
  priceEth                String               @default("0") @db.VarChar(64)
  audioSourceName         String?              @db.VarChar(255)
  coverSourceName         String?              @db.VarChar(255)
  audioStorageObjectId    String?
  coverStorageObjectId    String?
  metadataStorageObjectId String?
  chainId                 Int?
  chainName               String?              @db.VarChar(64)
  explorerUrl             String?              @db.VarChar(255)
  musicAssetAddress       String?              @db.VarChar(42)
  platformHubAddress      String?              @db.VarChar(42)
  splitterAddress         String?              @db.VarChar(42)
  publishTxHash           String?              @db.VarChar(100)
  publishBlockNumber      BigInt?
  tokenId                 String?              @db.VarChar(128)
  metadataDocument        Json?
  revenueSplits           Json?
  statusMessage           String?              @db.VarChar(255)
  latestError             String?              @db.Text
  publishedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  creator                 User                 @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  audioStorageObject      StorageObject?       @relation("CreatorReleaseAudioObject", fields: [audioStorageObjectId], references: [id], onDelete: Restrict)
  coverStorageObject      StorageObject?       @relation("CreatorReleaseCoverObject", fields: [coverStorageObjectId], references: [id], onDelete: Restrict)
  metadataStorageObject   StorageObject?       @relation("CreatorReleaseMetadataObject", fields: [metadataStorageObjectId], references: [id], onDelete: Restrict)
  purchases               Purchase[]
  royaltyClaims           RoyaltyClaim[]
  comments                Comment[]

  @@unique([chainId, musicAssetAddress, tokenId])
  @@index([creatorUserId, updatedAt])
  @@index([creatorUserId, status, updatedAt])
  @@index([creatorUserId, slug])
  @@index([audioStorageObjectId])
  @@index([coverStorageObjectId])
  @@index([metadataStorageObjectId])
  @@map("creator_releases")
}

model Purchase {
  id                 String         @id @default(cuid())
  releaseId          String
  buyerUserId        String
  walletAddress      String         @db.VarChar(42)
  walletAddressLower String         @db.VarChar(42)
  chainId            Int
  txHash             String         @db.VarChar(100)
  txHashLower        String         @db.VarChar(100)
  amountWei          String         @db.VarChar(128)
  status             PurchaseStatus @default(pending)
  purchasedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  release            CreatorRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  buyer              User           @relation("PurchaseBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHashLower])
  @@unique([releaseId, walletAddressLower, chainId])
  @@index([releaseId, status, createdAt])
  @@index([buyerUserId, createdAt])
  @@map("purchases")
}

model RoyaltyClaim {
  id                   String         @id @default(cuid())
  releaseId            String
  claimerUserId        String
  accountAddress       String         @db.VarChar(42)
  accountAddressLower  String         @db.VarChar(42)
  splitterAddress      String         @db.VarChar(42)
  splitterAddressLower String         @db.VarChar(42)
  chainId              Int
  txHash               String         @db.VarChar(100)
  txHashLower          String         @db.VarChar(100)
  amountWei            String         @db.VarChar(128)
  claimedAt            DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  release              CreatorRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  claimer              User           @relation("RoyaltyClaimClaimer", fields: [claimerUserId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHashLower])
  @@index([releaseId, claimedAt])
  @@index([claimerUserId, createdAt])
  @@index([accountAddressLower, chainId, claimedAt])
  @@index([splitterAddressLower, chainId])
  @@map("royalty_claims")
}

model Comment {
  id        String         @id @default(cuid())
  releaseId String
  userId    String
  body      String         @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  release   CreatorRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}
