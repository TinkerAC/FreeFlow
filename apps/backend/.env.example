NODE_ENV=development
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freeflow_web25?schema=public
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,null
ALLOW_NULL_ORIGIN=true

SIWE_DOMAIN=freeflow.local
SIWE_URI=https://freeflow.local/web2.5
SIWE_STATEMENT=Sign in to FreeFlow Web2.5 services.
SIWE_ALLOWED_CHAIN_IDS=11155111
NONCE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=ff_web25_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

PINATA_JWT=replace-with-your-pinata-jwt
PINATA_API_BASE_URL=https://uploads.pinata.cloud/v3/files
PINATA_GATEWAY_BASE_URL=https://gateway.pinata.cloud/ipfs
PINATA_NETWORK=public
# PINATA_GROUP_ID=

UPLOAD_MAX_FILE_SIZE_MB=150
